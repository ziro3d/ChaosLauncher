<Window x:Class="ChaosLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CHAOS Launcher"
        Height="560"
        Width="900"
        MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0C0D11"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#121319"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#181920"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="#252630"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#B83245"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#D44759"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#8F2434"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F3"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#92929F"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#62626F"/>


        <!-- MINIMIZE BUTTON -->
        <Style x:Key="MinimizeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#858590"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#25262F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- CLOSE BUTTON -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#858590"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E74444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- PLAY BUTTON -->
        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- COMBOBOX ITEM STYLE -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#D8D8E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#29252A"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#29252A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- LAUNCHER COMBOBOX -->
        <Style x:Key="LauncherComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#191A21"/>
            <Setter Property="Foreground" Value="#EEEEF2"/>
            <Setter Property="BorderBrush" Value="#30313A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        Grid.Column="0"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        IsHitTestVisible="False"/>

                                    <Path Grid.Column="1"
                                          Data="M 0,0 L 4,4 L 8,0"
                                          Stroke="#A6A6B2"
                                          StrokeThickness="1.6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>

                                    <ToggleButton
                                        Grid.ColumnSpan="2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="#17181F"
                                        BorderBrush="#30313A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,0"
                                        Padding="5">
                                    <ScrollViewer CanContentScroll="True" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#55515A"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <!-- MAIN WINDOW -->
    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="#292A33"
            BorderThickness="1"
            CornerRadius="14"
            Padding="1">

        <Grid>

            <!-- TOP ACCENT LINE -->
            <Border Height="2" VerticalAlignment="Top" Background="{StaticResource AccentBrush}" CornerRadius="14,14,0,0"/>

            <!-- MAIN CONTENT WRAPPER -->
            <Grid Margin="27,20,27,24">

                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>


                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,17" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LOGO -->
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#241710" BorderBrush="#54301F" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="C" FontSize="25" FontWeight="Black" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- TITLE -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                        <TextBlock FontSize="19" FontWeight="Bold">
                            <Run Foreground="#FFB83245" Text="CHAOS"/>
                            <Run Text=" "/>
                            <Run Foreground="#FFF0F0F3" Text=": THE BEST GAME EVER"/>
                        </TextBlock>
                        <TextBlock x:Name="LauncherSubtitle" Text="GAME LAUNCHER" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="1,3,0,0"/>
                    </StackPanel>

                    <!-- WINDOW CONTROLS -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Content="⚙" Style="{StaticResource MinimizeButtonStyle}" FontSize="15" Click="SettingsButton_Click" Margin="0,0,4,0" ToolTip="Settings"/>
                        <Button Content="—" Style="{StaticResource MinimizeButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                        <Button Content="✕" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" Margin="5,0,0,0" ToolTip="Close"/>
                    </StackPanel>
                </Grid>


                <!-- PATCH NOTES PANEL -->
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="11" Padding="20,15,20,20" Margin="0,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- PATCH HEADER -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="3" Height="17" Background="{StaticResource AccentBrush}" CornerRadius="2" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PatchHeaderTitle" Text="PATCH NOTES &amp; UPDATES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="PatchHeaderSub" Text="Latest news and game updates" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <TextBlock x:Name="NewsBadgeText" Grid.Column="2" Text="NEWS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Background="#281810" Padding="10,4"/>
                        </Grid>

                        <Border Grid.Row="0" Height="1" Background="#282931" VerticalAlignment="Bottom" Margin="0,0,0,5"/>

                        <!-- PATCH CONTENT -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,13,0,0">
                            <TextBlock x:Name="PatchNotesText" Text="Loading changelog..." TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="#B6B6C3"/>
                        </ScrollViewer>
                    </Grid>
                </Border>


                <!-- BOTTOM PANEL -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- STATUS -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#E99A42" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#E99A42" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClientStatusLabel" Text="CLIENT STATUS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="StatusText" Text="Checking for updates..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- PLAY BUTTON -->
                    <Button x:Name="PlayButton" Grid.Column="1" Content="PLAY" Width="165" Height="48" Style="{StaticResource PlayButtonStyle}" Click="PlayButton_Click" VerticalAlignment="Center"/>
                </Grid>

            </Grid>


            <!-- MODAL OVERLAY FOR LAUNCHER SETTINGS -->
            <Grid x:Name="DxModalOverlay" Background="#BB07080C" Visibility="Collapsed" Panel.ZIndex="100">
                <Border Background="#14151C" BorderBrush="#2B2C38" BorderThickness="1" CornerRadius="14" Width="500" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock x:Name="SettingsTitleText" Text="LAUNCHER SETTINGS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SettingsSubText" Text="Configure rendering and client preferences" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Grid.Row="1" Margin="0,4,0,20"/>

                        <!-- Options Content -->
                        <StackPanel Grid.Row="2">

                            <!-- GRAPHICS API SECTION -->
                            <TextBlock x:Name="ApiSectionLabel" Text="GRAPHICS API" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Content="DirectX 11" Grid.Column="0" Height="40" Style="{StaticResource PlayButtonStyle}" Click="Dx11Select_Click" MouseEnter="Dx11_MouseEnter" MouseLeave="DxButton_MouseLeave"/>
                                <Button Content="DirectX 12" Grid.Column="2" Height="40" Style="{StaticResource PlayButtonStyle}" Click="Dx12Select_Click" MouseEnter="Dx12_MouseEnter" MouseLeave="DxButton_MouseLeave"/>
                            </Grid>

                            <!-- LANGUAGE SECTION -->
                            <TextBlock x:Name="LangSectionLabel" Text="LANGUAGE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,8"/>
                            <ComboBox x:Name="LanguageCombo" Style="{StaticResource LauncherComboBox}" Height="36" Margin="0,0,0,15" SelectionChanged="LanguageCombo_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="Русский (Russian)" Tag="ru"/>
                                <ComboBoxItem Content="Deutsch (German)" Tag="de"/>
                                <ComboBoxItem Content="Français (French)" Tag="fr"/>
                                <ComboBoxItem Content="Italiano (Italian)" Tag="it"/>
                                <ComboBoxItem Content="Español (Spanish)" Tag="es"/>
                                <ComboBoxItem Content="Türkçe (Turkish)" Tag="tr"/>
                                <ComboBoxItem Content="Polski (Polish)" Tag="pl"/>
                                <ComboBoxItem Content="日本語 (Japanese)" Tag="ja"/>
                            </ComboBox>

                            <!-- Description Text -->
                            <TextBlock x:Name="DxDescriptionText" Text="Hover over an option to view detailed description." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Height="30"/>

                        </StackPanel>

                        <!-- Footer -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <CheckBox x:Name="RememberCheckBox" Content="Remember my graphics selection" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Click="RememberCheckBox_Click"/>
                            <Button x:Name="SaveCloseButton" Content="Save &amp; Close" Width="100" Height="32" Style="{StaticResource PlayButtonStyle}" FontSize="12" HorizontalAlignment="Right" Click="CancelModal_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>

</Window>